{{- $.Scratch.Add "seen" slice -}}
{{- $.Scratch.Add "index" slice -}}
{{- range where .Site.RegularPages "Section" "post" -}}
  {{- if not (in ($.Scratch.Get "seen") .Permalink) -}}
    {{- $.Scratch.Add "seen" .Permalink -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "date" (.Date.Format "2006-01-02") "tags" .Params.tags "categories" .Params.categories "content" .Plain "permalink" .Permalink) -}}
  {{- end -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
